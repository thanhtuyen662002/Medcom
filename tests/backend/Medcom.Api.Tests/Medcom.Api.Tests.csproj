<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/backend/Medcom.Api/Medcom.Api.csproj" />
    <ProjectReference Include="../../../tools/local-frontend/Medcom.LocalFrontendHost/Medcom.LocalFrontendHost.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Nearly every HTTP test builds a fresh ApiHost (~370 minimal-API endpoints).
         With dynamic code on, each host re-emits and JITs its own request delegates,
         DI resolvers and JSON accessors: ~2.5 CPU-seconds per host. On 4-vCPU CI
         runners with test classes in parallel that became 20-50 s per test, timed
         out InboundDraftEndpointTests' 20 s client and pushed backend-windows past
         its 45-minute limit. The framework's interpreted/reflection paths have the
         same behaviour and keep a host cold start near 0.2 s. Test process only. -->
    <RuntimeHostConfigurationOption Include="System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeSupported" Value="false" />
  </ItemGroup>
</Project>
