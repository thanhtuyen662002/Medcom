{
  "name": "medcom-developer-docs",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "docusaurus start --host 127.0.0.1 --port 3001",
    "generate": "node scripts/generate.mjs",
    "sync": "node scripts/sync-contract.mjs",
