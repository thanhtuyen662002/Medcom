  "limits": [
    "no L07 dispatcher lease or writer token",
    "no exact pilot command signature, procedure binding, transaction owner or hook order proved",
    "no authorized raw SQL/source/runtime opened or executed",
    "no database mutation, lock test or legacy command dispatch",
    "no product code, CI or current-head implementation test",
    "no GitHub mutation or issue closure"
  ],
  "unit_id": "L07-B3-ENVELOPE",
  "graph_id": "B3",
  "issue": 22,
  "objective": "Validate a closed typed command envelope before any evidence-bound handler dispatch.",
  "conceptual_envelope": [
    "registered_action_id",
    "contract_version",
    "tenant_company_data_source_identity",
    "authenticated_principal",
    "server_scope_generation",
    "permission_generation",
    "business_reference",
    "typed_payload",
    "idempotency_key_when_required",
    "semantic_fingerprint",
    "correlation_id",
    "client_metadata_revision_hint",
    "resolved_server_metadata_revision"
  ],
  "cases": [
    {
      "id": "CMD-01",
      "scenario": "client supplies SQL table/procedure/method name",
      "expected": "reject before resolution; registry accepts only registered ActionId and typed contract"
    },
    {
      "id": "CMD-02",
      "scenario": "unknown ActionId or contract version",
      "expected": "fail closed with safe code; no dynamic dispatch"
    },
    {
      "id": "CMD-03",
      "scenario": "extra or unknown payload field",
      "expected": "closed schema rejects; no mass assignment"
    },
    {
      "id": "CMD-04",
      "scenario": "client widens company/branch/storehouse",
      "expected": "server-derived scope retained; deny before side effects"
    },
    {
      "id": "CMD-05",
      "scenario": "permission generation stale at mutation boundary",
      "expected": "reauthorize/deny before dispatch"
    },
    {
      "id": "CMD-06",
      "scenario": "business state changed after form load",
      "expected": "state guard rechecked in protected command path"
    },
    {
      "id": "CMD-07",
      "scenario": "reference belongs to foreign parent/scope",
      "expected": "ownership/link validated; no foreign existence leak"
    },
    {
      "id": "CMD-08",
      "scenario": "read-only/derived field included in payload",
      "expected": "reject or ignore only by explicit typed policy; never write by reflection"
    },
    {
      "id": "CMD-09",
      "scenario": "screen configuration injects an executable action",
      "expected": "registry requires reviewed server contract; config is presentation only"
    },
    {
      "id": "CMD-10",
      "scenario": "correlation ID copied from another operation",
      "expected": "correlation grants no identity, permission, idempotency or result access"
    },
    {
      "id": "CMD-11",
      "scenario": "handler binding lacks exact source/build/database identity",
      "expected": "command remains unsupported; no guessed fallback"
    },
    {
      "id": "CMD-12",
      "scenario": "response transport fails after dispatch",
      "expected": "enter OutcomeUnknown when commit cannot be excluded; no blind retry"
    },
    {
      "id": "CMD-13",
      "scenario": "browser supplies metadataRevision newer, older or for another action",
      "expected": "treat as compatibility hint; resolve authoritative server metadata revision and reject stale/mismatched contract before dispatch"
    },
    {
      "id": "CMD-14",
      "scenario": "browser supplies tenant, principal, scope generation, server defaults or semantic fingerprint",
      "expected": "ignore/reject client authority fields; derive all dispatch authority and fingerprint inputs on server"
    },
    {
      "id": "CMD-15",
      "scenario": "server registry revision changes after validation but before dispatch",
      "expected": "fenced dispatch rechecks the same resolved registry revision atomically or aborts before side effect"
    },
    {
      "id": "CMD-16",
      "scenario": "presentation config references a registered action but server metadata marks it retired or unsupported",
      "expected": "server registry decision wins; UI reference cannot resurrect executable capability"
    }
  ],
  "execution_status": "NOT_RUN",
  "authority_split": {
    "browser_may_supply": [
      "registered_action_id",
      "contract_version",
      "business_reference",
      "typed_payload",
      "idempotency_key_when_required",
      "client_metadata_revision_hint",
      "correlation_id"
    ],
    "server_must_derive": [
      "tenant_company_data_source_identity",
      "authenticated_principal",
      "server_scope_generation",
      "permission_generation",
      "resolved_server_metadata_revision",
      "server_resolved_defaults",
      "semantic_fingerprint"
    ],
    "rule": "browser metadata revision is an optimistic compatibility hint only; server registry revision, scope, defaults, fingerprint and dispatch binding are authoritative"
  }
}
