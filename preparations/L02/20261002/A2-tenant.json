{
  "issue": 13,
  "acceptance": "server authoritative resolver with scoped resource isolation",
  "cases": [
    {
      "id": "A2-01",
      "synthetic_scenario": "Alpha user submits Beta company/storehouse or client DB name",
      "expected_assertions": [
        "server scope cannot widen",
        "no connection profile/object name chosen by client",
        "denial leaks no existence/count"
      ],
      "defect_detected": "client-selected tenant/DB",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A2-02",
      "synthetic_scenario": "Alpha and Beta both have synthetic record id 7",
      "expected_assertions": [
        "queries/caches/pools/jobs/audit/hub partitions stay separate",
        "only authorized partition returned"
      ],
      "defect_detected": "identifier collision or cache key missing tenant",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A2-03",
      "synthetic_scenario": "same company, different principals with unequal capability",
      "expected_assertions": [
        "user-specific cache/session/capability partition retained",
        "one user cannot inherit broader cached result"
      ],
      "defect_detected": "same-company user isolation failure",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A2-04",
      "synthetic_scenario": "switch company while request/export/background job is in flight",
      "expected_assertions": [
        "old operation remains bound to authenticated scope snapshot",
        "result is not revealed under new session generation"
      ],
      "defect_detected": "late response cross-scope leak",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A2-05",
      "synthetic_scenario": "shared/per-company/multi-database synthetic profiles",
      "expected_assertions": [
        "only server allowlisted mapping supplies connection policy",
        "UI cannot switch to an unapproved profile"
      ],
      "defect_detected": "deployment profile becomes browser authority",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A2-06",
      "synthetic_scenario": "server data-source/profile mapping generation changes while a pooled connection, cache key, job or hub membership remains from the old generation",
      "expected_assertions": [
        "old generation cannot be reused under the new mapping",
        "pool/cache/job/hub identity includes the authoritative mapping generation and safe disposal/revalidation occurs"
      ],
      "defect_detected": "cross-generation data-source reuse",
      "execution_status": "not_run_against_product"
    }
  ],
