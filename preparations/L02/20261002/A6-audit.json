{
  "issue": 17,
  "acceptance": "safe correlation and separate business/security audit versus bounded diagnostic trace",
  "cases": [
    {
      "id": "A6-01",
      "synthetic_scenario": "caller supplies support/correlation id from another synthetic user",
      "expected_assertions": [
        "correlation is not identity/scope/permission/idempotency",
        "support trace API reauthorizes independently"
      ],
      "defect_detected": "correlation becomes authority",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A6-02",
      "synthetic_scenario": "fixture payload includes canary credential/token/connection-string/executable config fields",
      "expected_assertions": [
        "logs redact secrets/unrestricted payload",
        "allowed audit fields remain useful; no production strings used"
      ],
      "defect_detected": "sensitive logs and over-redaction hiding audit",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A6-03",
      "synthetic_scenario": "business command dispatched then response lost",
      "expected_assertions": [
        "outcome remains Unknown until authoritative/idempotency reconciliation",
        "no blind replay and no fabricated success/failure"
      ],
      "defect_detected": "duplicate effect or false outcome",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A6-04",
      "synthetic_scenario": "diagnostic trace sink fails but business command outcome authoritative",
      "expected_assertions": [
        "trace outage does not fabricate business failure",
        "audit atomicity remains UNKNOWN until verified transaction contract"
      ],
      "defect_detected": "diagnostic failure changes command result",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A6-05",
      "synthetic_scenario": "cross-scope support query or unbounded time window",
      "expected_assertions": [
        "separate server support permission and scope limits",
        "bounded query/retention; no invented numeric legal periods"
      ],
      "defect_detected": "support API bypass and resource abuse",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A6-06",
      "synthetic_scenario": "attacker supplies newline/control-character/structured-field collisions in safe error, actor, action and correlation inputs",
      "expected_assertions": [
        "structured logging prevents forged records and strips invalid control characters",
        "server-owned audit fields cannot be overwritten; redacted diagnostic data remains bounded"
      ],
      "defect_detected": "log injection or audit-field spoofing",
      "execution_status": "not_run_against_product"
    }
  ],
