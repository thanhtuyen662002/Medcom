{
  "issue": 15,
  "acceptance": "independent server navigation/route/query/mutation/export enforcement",
  "cases": [
    {
      "id": "A4-01",
      "synthetic_scenario": "server route/data grant absent; menu hidden; attacker crafts direct route/API request",
      "expected_assertions": [
        "route and data independently deny because authoritative server grants are absent",
        "UI visibility or presentation omission never determines permission"
      ],
      "defect_detected": "navigation-only authorization",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A4-02",
      "synthetic_scenario": "allow route but deny query/filter/count within crafted scope",
      "expected_assertions": [
        "allowlisted typed query is required",
        "server injects effective scope",
        "denial reveals no out-of-scope count/existence"
      ],
      "defect_detected": "data authority bypass",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A4-03",
      "synthetic_scenario": "mutation capability previously allowed but business state changed",
      "expected_assertions": [
        "capability/scope/business state revalidated at mutation boundary",
        "no unauthorized side effect"
      ],
      "defect_detected": "TOCTOU or state bypass",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A4-04",
      "synthetic_scenario": "report URL/file token reused after role revoked",
      "expected_assertions": [
        "export/file endpoint independently reauthorizes current scope/generation",
        "download cache cannot disclose revoked data"
      ],
      "defect_detected": "export authorization bypass",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A4-05",
      "synthetic_scenario": "role revoked but SignalR invalidation lost",
      "expected_assertions": [
        "authoritative revalidation/SWR fallback denies without relogin",
        "hint absence is not continued authority"
      ],
      "defect_detected": "push notification mistaken for enforcement",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A4-06",
      "synthetic_scenario": "non-admin edits quick-nav/admin settings/executable screen config",
      "expected_assertions": [
        "presentation cannot confer capabilities",
        "non-admin mutation denied server-side"
      ],
      "defect_detected": "configuration privilege escalation",
      "execution_status": "not_run_against_product"
    },
    {
      "id": "A4-07",
      "synthetic_scenario": "same-company user guesses another user-owned opaque record and compares denial shape and latency distribution",
      "expected_assertions": [
        "uniform safe response reveals no protected fields/count/existence",
        "measure and record timing residual; never claim perfect timing indistinguishability without evidence"
      ],
      "defect_detected": "same-scope enumeration or unmeasured timing leak",
      "execution_status": "not_run_against_product"
    }
