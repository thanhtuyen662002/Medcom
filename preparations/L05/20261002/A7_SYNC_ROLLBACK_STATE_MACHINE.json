  "unit_id": "L05-A7-SYNC-ROLLBACK",
  "graph_id": "A7",
  "issue": 18,
  "objective": "Define an immutable publish/rollback flow resilient to missed events, stale writers and WinForms cache divergence.",
  "states": [
    "NO_PUBLISHED_VERSION",
    "PUBLISHED_GOOD",
    "CANDIDATE_DETECTED",
    "CANDIDATE_VALIDATING",
    "CANDIDATE_QUARANTINED",
    "PUBLISH_CONFLICT",
    "PUBLISHED_NEW",
    "ROLLBACK_VALIDATING",
    "ROLLBACK_CONFLICT",
    "ROLLED_BACK_POINTER",
    "DEGRADED_LAST_GOOD",
    "STALE_PUBLISHER_REJECTED",
    "SOURCE_SET_INCOMPLETE"
  ],
  "cases": [
    {
      "id": "SYN-01",
      "event": "source watcher fires",
      "expected": "hash authoritative source and create immutable candidate only if changed"
    },
    {
      "id": "SYN-02",
      "event": "watcher misses source change",
      "expected": "periodic/manual hash reconciliation detects drift"
    },
    {
      "id": "SYN-03",
      "event": "parser/validator fails",
      "expected": "candidate quarantined; current pointer unchanged"
    },
    {
      "id": "SYN-04",
      "event": "executable reference unresolved",
      "expected": "candidate quarantined; no browser/runtime activation"
    },
    {
      "id": "SYN-05",
      "event": "two admins publish from same expected pointer",
      "expected": "one transactional CAS succeeds; other conflicts and refreshes"
    },
    {
      "id": "SYN-06",
      "event": "publish transaction commits",
      "expected": "audit/current pointer/checkpoint durable before post-commit invalidation"
    },
    {
      "id": "SYN-07",
      "event": "SignalR invalidation lost",
      "expected": "SWR/poll/focus/manual re-fetch converges; no activity/session extension"
    },
    {
      "id": "SYN-08",
      "event": "WinForms Forever1Day cache remains old",
      "expected": "do not claim convergence; controlled refresh/restart acceptance belongs to Q3/A7"
    },
    {
      "id": "SYN-09",
      "event": "admin selects previous-good rollback version",
      "expected": "revalidate source/compiler/action/build/schema compatibility and expected pointer"
    },
    {
      "id": "SYN-10",
      "event": "rollback pointer races newer publish",
      "expected": "rollback conflicts; never overwrite newer current pointer"
    },
    {
      "id": "SYN-11",
      "event": "historical version references retired/unauthorized command",
      "expected": "rollback candidate quarantined"
    },
    {
      "id": "SYN-12",
      "event": "service cannot fetch new definition",
      "expected": "serve explicitly scoped previous-good where compatible or fail closed; never fabricate mixed version"
    },
    {
      "id": "SYN-13",
      "event": "stale publisher has correct pointer but obsolete publisher epoch or lease",
      "expected": "atomic compare includes owner epoch and expected pointer; stale writer rejected before mutation"
    },
    {
      "id": "SYN-14",
      "event": "multi-file source set changes during scan/compile",
      "expected": "manifest snapshot equality is rechecked before publish; mixed generation becomes SOURCE_SET_INCOMPLETE"
    },
    {
      "id": "SYN-15",
      "event": "database commit succeeds but publisher loses acknowledgement",
      "expected": "read current pointer/audit by immutable operation identity before retry; never publish a second version blindly"
    },
    {
      "id": "SYN-16",
      "event": "clock moves backward or nodes disagree on wall time",
      "expected": "ordering and conflicts use immutable IDs/monotonic epochs, not timestamps as authority"
    }
  ],
  "invariants": [
    "versions/history are immutable",
    "publication/rollback changes only a current pointer transactionally",
    "business data is never reversed by config rollback",
    "overrides cannot grant authorization or scope",
    "source/compiler/build/schema compatibility is checked",
    "checkpoint distinguishes last observed source from last successful publication",
    "invalidation occurs only after commit",
    "publisher ownership is fenced by an epoch in the same atomic decision as pointer CAS",
    "a published version references one complete immutable source-set manifest"
  ],
  "execution_status": "NOT_RUN"
}
