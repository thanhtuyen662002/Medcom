  "objective": "Make direct-load versus private bridge selection depend on evidence, while keeping Web contracts free of legacy types.",
  "options": [
    {
      "option": "DIRECT_LOAD_IN_DEDICATED_COMPATIBILITY_WORKER",
      "minimum_evidence": [
        "exact binary/dependency/host compatibility",
        "controlled load and disposal",
        "per-session state isolation or dedicated process proof",
        "thread/reentrancy and failure behavior",
        "private deployment and license handling"
      ],
      "rejection_triggers": [
        "any dependency/runtime incompatibility",
        "unaccounted process-global state",
        "unsafe startup DDL",
        "unbounded resource behavior",
        "legacy types escape boundary"
      ]
    },
    {
      "option": "PRIVATE_DOTNET_FRAMEWORK_BRIDGE",
      "minimum_evidence": [
        "authenticated private service boundary",
        "one serialized session context until sharing is proved",
        "strict typed schema/size/time limits",
        "bounded queue/backpressure/readiness",
        "secret provisioning and sanitized diagnostics",
        "generation fencing and ambiguous outcome handling"
      ],
      "rejection_triggers": [
        "Internet/browser reachability",
        "shared mutable user context without proof",
        "unbounded queue",
        "raw Tool DTO/credentials/DB handles exposed",
        "blind retry of ambiguous state change"
      ]
    },
    {
      "option": "UNSUPPORTED_FAIL_CLOSED",
      "minimum_evidence": [
        "explicit unavailable capability and support-safe reason",
        "dependent feature remains disabled",
        "no downgrade to browser/SQL direct access"
      ],
      "rejection_triggers": [
        "silent fallback that weakens authorization",
        "guessed semantics or production probing"
      ]
    }
  ],
