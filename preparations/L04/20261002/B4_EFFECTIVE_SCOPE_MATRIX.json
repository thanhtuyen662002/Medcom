  "issue": 23,
  "objective": "Make permission/company/branch/storehouse precedence observable without inferring authority from UI flags or static names.",
  "authoritative_principles": [
    "server derives effective scope; browser values cannot widen it",
    "navigation, route, query/data, mutation/state and export/file are independently enforced",
    "UI hidden/read-only/edit flags and menu ancestry are evidence inputs, never backend authority",
    "denial must not reveal out-of-scope existence or counts",
    "role/scope changes require current generation revalidation"
  ],
