  "unit_id": "L06-F2-GRID",
  "graph_id": "F2",
  "issue": 29,
  "objective": "Define shared Grid Core behavior for synthetic 100k-row/100+-column contracts without domain actions or full client downloads.",
  "dataset_contract": {
    "minimum_cardinality_exclusive": 100000,
    "fixture_rows": 100001,
    "potential_columns": 120,
    "synthetic_only": true,
    "stable_row_ids": "required",
    "server_windowing": "required",
    "browser_full_materialization": "prohibited"
  },
  "cases": [
    {
      "id": "GRD-01",
      "scenario": "virtual scroll across 100,001 rows (cardinality >100k)",
      "expected": "bounded DOM/window; logical row identity preserved"
    },
    {
      "id": "GRD-02",
      "scenario": "120 columns with frozen identity/action columns",
      "expected": "column virtualization where needed; no page-level accidental horizontal overflow"
    },
    {
      "id": "GRD-03",
      "scenario": "sort with duplicate values",
      "expected": "deterministic server sort includes stable tie-breaker"
    },
    {
      "id": "GRD-04",
      "scenario": "selection moves outside viewport then safe refresh",
      "expected": "selection tracks stable ID and declared dataset version, not DOM index"
    },
    {
      "id": "GRD-05",
      "scenario": "Shift range and Ctrl/Cmd additive selection",
      "expected": "declared selected universe/count; unloaded rows not silently implied"
    },
    {
      "id": "GRD-06",
      "scenario": "Home/End/PageUp/PageDown",
      "expected": "predictable logical movement with announced row/column context"
    },
    {
      "id": "GRD-07",
      "scenario": "Enter/Escape/Tab/Shift+Tab",
      "expected": "edit/open/cancel/traversal follows visible documented mode"
    },
    {
      "id": "GRD-08",
      "scenario": "screen config requests domain approve action inside Grid Core",
      "expected": "reject separation violation; action remains screen/command contract"
    },
    {
      "id": "GRD-09",
      "scenario": "masked field hidden but used in sort/filter/total/export",
      "expected": "server field authorization prevents inference on every path"
    },
    {
      "id": "GRD-10",
      "scenario": "saved view contains retired or unauthorized column",
      "expected": "unknown/denied stable IDs removed or reported; no silent remap"
    },
    {
      "id": "GRD-11",
      "scenario": "empty, denied, error, not-found and filter-empty responses",
      "expected": "distinct accessible states without existence leak"
    },
    {
      "id": "GRD-12",
      "scenario": "status cells",
      "expected": "text plus semantic non-color signal; no arbitrary per-screen color meaning"
    },
    {
      "id": "GRD-13",
      "scenario": "390px ordinary document list",
      "expected": "semantic card/list with 4–6 high-value items; no default shrunk desktop grid"
    },
    {
      "id": "GRD-14",
      "scenario": "bulk action over page versus selected versus all filtered",
      "expected": "explicit universe/count/version and server revalidation; no false atomicity"
    },
    {
      "id": "GRD-15",
      "scenario": "local selection/resize/menu interaction under 100,001-row and 120-column synthetic fixture",
      "expected": "measure local interaction p95 <=100 ms; record p75/p95 and environment rather than infer success from 60fps or one sample"
    },
    {
      "id": "GRD-16",
      "scenario": "100,001-row page renders with lookup enrichment",
      "expected": "bounded batched lookup/query count; no per-row N+1 calls or browser full materialization"
    },
    {
      "id": "GRD-17",
      "scenario": "master list refreshes from record/version A to B while detail A is open",
      "expected": "detail identity/version is fenced; never show detail A beneath selected master B"
    },
    {
      "id": "GRD-18",
      "scenario": "virtualized row DOM is recycled while keyboard focus/edit anchor remains",
      "expected": "active cell and pending action bind stable rowRef plus fieldId, never recycled DOM index"
    },
    {
      "id": "GRD-19",
      "scenario": "selection spans pages then filter/query fingerprint changes",
      "expected": "selection is cleared or explicitly reconciled; never reinterpret prior selection as all rows in new query"
    }
  ],
  "execution_status": "NOT_RUN",
  "performance_budget": {
    "local_interaction_p95_ms_max": 100,
    "normal_indexed_filter_sort_p95_ms_max": 1000,
    "first_useful_grid_p75_ms_max": 1500,
    "first_useful_grid_p95_ms_max": 2500,
    "progress_after_ms": 300,
    "slow_network_fixture_ms": 10000
  }
