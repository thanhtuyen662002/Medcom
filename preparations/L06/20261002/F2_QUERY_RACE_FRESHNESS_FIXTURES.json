  "unit_id": "L06-F2-QUERY-RACE",
  "graph_id": "F2",
  "issue": 29,
  "objective": "Prevent stale/superseded query results, scope drift and false freshness in the shared query state.",
  "cases": [
    {
      "id": "QRY-01",
      "scenario": "search A then AB then ABC returns in reverse order",
      "expected": "only latest request identity may update current result"
    },
    {
      "id": "QRY-02",
      "scenario": "filter changes while old request is in flight",
      "expected": "abort/supersede old request; late response ignored"
    },
    {
      "id": "QRY-03",
      "scenario": "company or role generation changes in flight",
      "expected": "old response fenced and purged; new scope reauthorizes"
    },
    {
      "id": "QRY-04",
      "scenario": "page request races changed sort/filter",
      "expected": "query key includes schema/scope/filter/sort/page and stable version"
    },
    {
      "id": "QRY-05",
      "scenario": "SWR retains prior data during safe refresh",
      "expected": "mark data age/refreshing; never represent stale data as current"
    },
    {
      "id": "QRY-06",
      "scenario": "SignalR event dropped/duplicated/reordered",
      "expected": "event is a hint; authoritative revalidation converges by policy"
    },
    {
      "id": "QRY-07",
      "scenario": "socket connected but DB/query stale",
      "expected": "do not show live/fresh based on transport alone"
    },
    {
      "id": "QRY-08",
      "scenario": "server returns totalCount/group summary for mixed authorized/foreign filters",
      "expected": "scope applied before aggregates and no foreign existence leak"
    },
    {
      "id": "QRY-09",
      "scenario": "client submits legacy FieldID, table or arbitrary operator",
      "expected": "typed allow-list rejects before query construction"
    },
    {
      "id": "QRY-10",
      "scenario": "manual refresh while mutation outcome is OutcomeUnknown",
      "expected": "reconcile authoritative record/operation status; do not imply retry or success"
    },
    {
      "id": "QRY-11",
      "scenario": "10-second latency while usable prior data exists",
      "expected": "non-blocking progress appears after about 300 ms; prior data is visibly stale/refreshing and remains safe to use"
    },
    {
      "id": "QRY-12",
      "scenario": "cached response key matches query text but tenant/company/principal generation differs",
      "expected": "cache isolation rejects cross-scope reuse and purges inaccessible data"
    },
    {
      "id": "QRY-13",
      "scenario": "cursor/page token reused after dataset version or deterministic sort contract changes",
      "expected": "server rejects/restarts pagination; client cannot splice mixed snapshots"
    },
    {
      "id": "QRY-14",
      "scenario": "conditional response reports not-modified after capability or field authorization changed",
      "expected": "authorization generation participates in validation; stale protected projection is discarded"
    }
  ],
  "execution_status": "NOT_RUN"
}
