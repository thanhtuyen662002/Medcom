  "issue": 28,
  "objective": "Exercise shell/navigation/mobile presentation against server-owned capability and session generations without treating visibility as authority.",
  "cases": [
    {
      "id": "SHL-01",
      "scenario": "authorized screen appears in server navigation",
      "expected": "stable ScreenId opens allowed route; page identity and context visible"
    },
    {
      "id": "SHL-02",
      "scenario": "screen absent from authorized navigation and server grant absent",
      "expected": "direct route/API denied; safe state reveals no data existence"
    },
    {
      "id": "SHL-03",
      "scenario": "attacker injects quick-nav ScreenId",
      "expected": "configuration rejected or omitted; quick-nav cannot create capability"
    },
    {
      "id": "SHL-04",
      "scenario": "role revoked while shell/tab is open",
      "expected": "authoritative revalidation removes navigation and protected content/actions"
    },
    {
      "id": "SHL-05",
      "scenario": "company switch with open tabs and cached navigation",
      "expected": "scope/session generation changes; old data and actions fenced before display/dispatch"
    },
    {
      "id": "SHL-06",
      "scenario": "browser back-forward cache restores protected page after logout",
      "expected": "revalidate before reveal; redirect safely if invalid"
    },
    {
      "id": "SHL-07",
      "scenario": "module recent/favorite points to retired or unauthorized screen",
      "expected": "shortcut omitted/disabled with safe recovery; never bypasses authorization"
    },
    {
      "id": "SHL-08",
      "scenario": "390px viewport",
      "expected": "persistent role-filtered quick nav plus full authorized drawer; touch labels/focus usable"
    },
    {
      "id": "SHL-09",
      "scenario": "desktop work tabs contain duplicate document IDs",
      "expected": "tab identity includes screen/scope/record instance and dirty state; no cross-scope collision"
    },
    {
      "id": "SHL-10",
      "scenario": "connection/freshness degraded",
      "expected": "truthful degraded state; no green live badge from socket alone"
    },
    {
      "id": "SHL-11",
      "scenario": "keyboard-only shell navigation",
      "expected": "visible focus, logical order, named controls and no focus trap"
    },
    {
      "id": "SHL-12",
      "scenario": "non-admin invokes quick-nav admin route/API",
      "expected": "server denies; UI does not show controls; denial is not the sole security boundary"
    },
    {
      "id": "SHL-13",
      "scenario": "server denies screen but stale client cache/hydration contains prior navigation or page bytes",
      "expected": "authorization is resolved before protected reveal; no flash of protected content or cached counts"
    },
    {
      "id": "SHL-14",
      "scenario": "login return route is external, malformed or points to unauthorized screen",
      "expected": "return target is same-origin allow-listed and reauthorized; otherwise route to a safe authorized landing page"
    },
    {
      "id": "SHL-15",
      "scenario": "two tabs switch company or revoke role concurrently",
      "expected": "cross-tab generation notice purges old scoped navigation/data; each tab revalidates before reveal or dispatch"
    },
    {
      "id": "SHL-16",
      "scenario": "mobile drawer/dialog closes after navigation or denial",
      "expected": "focus returns to a valid named control; background is not keyboard/assistive-technology reachable while overlay is active"
    }
  ],
