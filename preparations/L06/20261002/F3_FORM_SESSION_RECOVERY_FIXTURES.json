  "unit_id": "L06-F3-RECOVERY",
  "graph_id": "F3",
  "issue": 30,
  "objective": "Preserve user work and truthful outcomes across validation, conflicts, session expiry, lookups and uncertain completion.",
  "cases": [
    {
      "id": "FRM-01",
      "scenario": "submit has errors in active and hidden tabs",
      "expected": "inline errors plus page/tab summary and focus path; no toast-only validation"
    },
    {
      "id": "FRM-02",
      "scenario": "navigate/refresh with dirty form",
      "expected": "explicit recovery/discard path; sensitive fields not casually persisted"
    },
    {
      "id": "FRM-03",
      "scenario": "server record version changed",
      "expected": "conflict with reload/compare/reapply where safe; no silent last-write-wins"
    },
    {
      "id": "FRM-04",
      "scenario": "save ACK lost after possible commit",
      "expected": "OutcomeUnknown persistent state and authoritative reconciliation; no false toast or blind retry"
    },
    {
      "id": "FRM-05",
      "scenario": "server confirms save",
      "expected": "success feedback only after authoritative acknowledgment and resulting state"
    },
    {
      "id": "FRM-06",
      "scenario": "lookup A/AB/ABC responses reorder",
      "expected": "superseded result cannot alter selected stable ID or linked fields"
    },
    {
      "id": "FRM-07",
      "scenario": "selected legacy lookup reference is deleted/inaccessible",
      "expected": "explicit unresolved state; unrelated edit does not silently clear/replace"
    },
    {
      "id": "FRM-08",
      "scenario": "session warning then valid Continue",
      "expected": "server confirms current generation; dirty input remains scoped"
    },
    {
      "id": "FRM-09",
      "scenario": "Continue arrives after server expiry",
      "expected": "cannot revive; safe login/return/recovery flow"
    },
    {
      "id": "FRM-10",
      "scenario": "polling/SignalR/job updates continue without user action",
      "expected": "idle timeout still expires; passive traffic does not count"
    },
    {
      "id": "FRM-11",
      "scenario": "logout in one tab, dirty second tab remains",
      "expected": "protected dispatch denied; draft isolated and cannot replay automatically"
    },
    {
      "id": "FRM-12",
      "scenario": "support-worthy failure",
      "expected": "safe copyable correlation reference plus durable inline context; no SQL/stack secret leak"
    },
    {
      "id": "FRM-13",
      "scenario": "duplicate refresh events",
      "expected": "deduplicated/non-spam feedback; no repeated toasts"
    },
    {
      "id": "FRM-14",
      "scenario": "offline/reconnect before critical submit",
      "expected": "reauthorize scope/version/freshness; queued offline writes remain disabled by default"
    },
    {
      "id": "FRM-15",
      "scenario": "double click/Enter and retry submit before first acknowledgement",
      "expected": "single in-flight local intent; server command identity governs retry and ambiguous outcome reconciliation"
    },
    {
      "id": "FRM-16",
      "scenario": "draft recovery key collides across tenant/company/principal/record/version",
      "expected": "draft is isolated by authoritative scope and schema/version; foreign or incompatible draft cannot hydrate"
    },
    {
      "id": "FRM-17",
      "scenario": "hidden/configured-away required field blocks submit",
      "expected": "form/tab summary exposes an accessible resolution path or server/config marks state unsupported; no impossible form"
    },
    {
      "id": "FRM-18",
      "scenario": "post-login return route contains attacker origin or unauthorized record",
      "expected": "same-origin route allow-list and current authorization apply before navigation; no open redirect or protected reveal"
    }
  ],
